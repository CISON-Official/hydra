# Database
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/certificate_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=certificates
S3_REGION=us-east-1
S3_SECURE=false

# Security (CHANGE THESE!)
SECRET_KEY=your_super_secret_key_32_bytes_minimum_here
HMAC_SECRET_KEY=your_hmac_secret_key_32_bytes_minimum_here
SESSION_TOKEN_TTL_SECONDS=900

# QR Configuration
QR_BASE_URL=https://verify.yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true